# Leave these empty to run in DEMO MODE (sample data, nothing is saved).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by admin actions that must bypass RLS (never expose to the browser).
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public contact address used in the footer, listing pages and privacy page.
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional, server-only. Google Maps Routes API key: adds live traffic and detour detection to the road board.
GOOGLE_MAPS_API_KEY=
