# kaghannaran.com — Next.js app on 127.0.0.1:3106 (systemd: kaghannaran.service)
# Certbot adds the 443/SSL lines on first run.
upstream kaghannaran_app {
    server 127.0.0.1:3106;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name kaghannaran.com www.kaghannaran.com;

    if ($host = www.kaghannaran.com) { return 301 https://kaghannaran.com$request_uri; }

    # listing photos and documents are uploaded through server actions (limit 40 MB in next.config.ts)
    client_max_body_size 40m;
    gzip on;
    gzip_proxied any;
    gzip_types text/css application/javascript application/json text/plain application/xml image/svg+xml application/octet-stream;

    location /_next/static/ {
        proxy_pass http://kaghannaran_app;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # 3D map data (satellite imagery, heights, route): large and rarely changed
    location /terrain/ {
        proxy_pass http://kaghannaran_app;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=604800";
        access_log off;
    }

    location / {
        proxy_pass http://kaghannaran_app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
